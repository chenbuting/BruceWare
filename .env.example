# BruceWare 配置模板。复制为项目根目录 .env 后按需修改。

APP_NAME=BruceWare
APP_DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000

# 默认数据源（网页「设置」里保存后，以 data/app-settings.json 为准）
# 本地：
DATABASE_URL=sqlite:///./data/bruceware.db
# 远程 MySQL 示例：
# DATABASE_URL=mysql+pymysql://用户:密码@服务器IP:3306/bruceware
# 远程 PostgreSQL 示例：
# DATABASE_URL=postgresql+psycopg://用户:密码@服务器IP:5432/bruceware

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
